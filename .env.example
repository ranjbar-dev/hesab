# Postgres
POSTGRES_USER=hesab
POSTGRES_PASSWORD=hesab
POSTGRES_DB=hesab
POSTGRES_PORT=5432

# API
API_PORT=8080
JWT_SECRET=dev-insecure-admin-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=5m
TWOFA_PENDING_TTL=5m
# The admin/client SPAs call the API cross-origin, so these origins must match.
CORS_ORIGINS=http://localhost:3010,http://localhost:3020
# Required true for the SameSite=None refresh cookie. Browsers accept Secure
# cookies on http://localhost, so this works in dev too.
COOKIE_SECURE=true
COOKIE_DOMAIN=
TOTP_ISSUER=Hesab Admin
